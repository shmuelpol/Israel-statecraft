# Copy to .env — never commit real keys.
# Provider mode:
#   mock       (default — deterministic rule engine, no key, no network)
#   claude-cli (LIVE, no key — uses your logged-in local `claude` CLI as a
#               persistent AI session: adviser answers, Director channel and
#               world reactions become model-generated; run `claude login` first)
#   anthropic | openai (HTTP APIs, need a key) | recorded
MODEL_PROVIDER=mock

# High-capability model (offline Atlas generation / research tooling)
ATLAS_MODEL=claude-fable-5
# Fast runtime model (Director planning, actor decisions, classification)
RUNTIME_MODEL=claude-haiku-4-5-20251001

# Keys are read server-side only and are never exposed to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Server
PORT=8787
